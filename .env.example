# Server-only. Never use NEXT_PUBLIC_ for credentials.
# Leave Sanity blank to use the explicitly labeled dated snapshot.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=
# Required only for the seed script, never the read-only web app.
SANITY_WRITE_TOKEN=
# Use an organization API token with Context Viewer, not a project token.
SANITY_CONTEXT_URL=
SANITY_CONTEXT_TOKEN=

# Verified Modal OpenAI-compatible endpoint base URL ending in /v1.
MODAL_BASE_URL=
MODAL_MODEL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Alternative endpoint bearer authentication, if supported by your endpoint.
MODAL_API_KEY=
# Optional local development only: uses your existing official Modal CLI login.
# A hosted production build needs a proxy token instead.
MODAL_USE_CLI=false

# Optional access-code gate. Set true only when a private demo code is desired.
# When enabled, generate an access code (24+ characters) and session secret (32+ characters).
FINEPRINT_REQUIRE_ACCESS_CODE=false
FINEPRINT_AGENT_ACCESS_KEY=
FINEPRINT_SESSION_SECRET=
# Vercel Firewall SDK rule: fixed window, 5 requests per 600 seconds.
# Exact deployment host, for example your-project.vercel.app (no scheme).
FINEPRINT_FIREWALL_HOST=
FINEPRINT_RATE_LIMIT_ID=fineprint-demo
RATE_LIMIT_SECRET=
