    "allStudents": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "minimumAge": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "guardianConsent": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "oneTeam": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "workingPrototype": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "technicalNovelty": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "priorHackathonEntry": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "publicRepository": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "setupInstructions": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "videoMinutes": {
      "default": null,
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "videoAccessible": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "screenshotsCount": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "devpostComplete": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "aiUseDisclosed": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "eventId",
    "name",
    "track",
    "origin",
    "startedAt",
    "teamSize",
    "adultTeam",
    "eligibleResidency",
    "devMembership",
    "excludedAffiliation",
    "priorWorkCredited",
    "substantialNewWork",
    "usesSanity",
    "usesContext",
    "usesKnowledgeBase",
    "aiBuilt",
    "supportedFrontend",
    "entriesPerPath",
    "separatePosts",
    "englishSubmission",
    "requiresLogin",
    "judgeAccess",
    "projectIdentifier",
    "publishedPost",
    "hasChallengeTag",
    "seeksMultiplePrizes",
    "evidenceNote",
    "allStudents",
    "minimumAge",
    "guardianConsent",
    "oneTeam",
    "workingPrototype",
    "technicalNovelty",
    "priorHackathonEntry",
    "publicRepository",
    "setupInstructions",
    "videoMinutes",
    "videoAccessible",
    "screenshotsCount",
    "devpostComplete",
    "aiUseDisclosed"
  ],
  "additionalProperties": false
}
