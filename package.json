{
  "name": "fineprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:production": "node --import tsx scripts/verify-production.ts",
    "eval": "node --import tsx scripts/evaluate.ts",
    "sanity:seed": "node --env-file=.env.local --import tsx scripts/seed-sanity.ts",
    "sanity:verify": "node --env-file=.env.local --import tsx scripts/verify-sanity.ts",
    "context:verify": "node --env-file=.env.local --import tsx scripts/verify-context.ts",
    "eval:baseline": "node --env-file=.env.local --import tsx scripts/evaluate-baseline.ts",
    "schema:export": "node --import tsx scripts/export-schema.ts",
    "format": "prettier --write src tests scripts *.ts *.json",
    "format:check": "prettier --check src tests scripts *.ts *.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sanity/client": "^7.17.0",
    "@vercel/firewall": "1.2.5",
    "jose": "6.2.12",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
