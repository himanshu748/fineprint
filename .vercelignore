# Only the app and its public evaluation records are uploaded.
/*
!src
!public
!evaluation
/evaluation/*
!/evaluation/baseline.json
!/evaluation/live-context.json
!package.json
!package-lock.json
!next.config.ts
!next-env.d.ts
!tsconfig.json
!vercel.json
# Defense in depth for future files within allowed directories.
**/.env*
**/*.pem
**/*.key
**/node_modules
**/.DS_Store
